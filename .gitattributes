# 统一换行符：Windows 批处理必须是 CRLF，否则 cmd 解析会错乱
* text=auto

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.db    binary
*.zip   binary
*.exe   binary
*.dll   binary
